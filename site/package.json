{
	"name": "nodra-site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Official website for Nodra, served by TanStack Start on Cloudflare Workers",
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
